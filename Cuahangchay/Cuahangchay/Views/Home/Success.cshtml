@model Cuahangchay.Models.HoaDon
@{
    ViewData["Title"] = "Đặt hàng thành công";
    Layout = "~/Views/Shared/layoutnew.cshtml"; // Hoặc layout cậu đang dùng
}

<div class="container text-center" style="margin-top: 50px; margin-bottom: 50px;">

    @if (Model != null)
    {
        <i class="fa fa-check-circle text-success" style="font-size: 80px;"></i>
        <h2 class="mt-3 text-success">Đặt hàng thành công!</h2>
        <p class="lead">Mã đơn hàng của bạn là: <strong>#@Model.HoaDonID</strong></p>

        <div class="card shadow-sm mt-4 mx-auto" style="max-width: 500px;">
            <div class="card-body">
                <h4 class="card-title">Tổng thanh toán</h4>
                <h3 class="text-danger font-weight-bold">
                    @Model.TongTien?.ToString("N0") VNĐ
                </h3>
                <hr>

                @if (Model.TrangThai != "Đã thanh toán")
                {
                    <p class="text-muted mb-3">Vui lòng chọn phương thức thanh toán dưới đây:</p>

                    <a href="@Url.Action("CreatePaymentUrl", "Payment", new { hoaDonId = Model.HoaDonID })" class="btn btn-danger btn-lg btn-block w-100">
                        <img src="https://vnpay.vn/assets/images/logo-icon/logo-primary.svg" height="30" style="background:white; padding:2px; border-radius:4px; margin-right:10px;">
                        Thanh toán ngay qua VNPAY
                    </a>

                    <div class="mt-3">
                        <small class="text-muted">Hoặc</small>
                    </div>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary mt-2">Thanh toán tiền mặt khi nhận hàng</a>
                }
                else
                {
                    <div class="alert alert-success">
                        Đơn hàng đã được thanh toán qua VNPAY.<br>
                        Mã GD: @Model.MaGiaoDich
                    </div>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">Tiếp tục mua sắm</a>
                }
            </div>
        </div>
    }
    else
    {
        <h2>Cảm ơn bạn đã ghé thăm!</h2>
        <p>Chúc bạn một ngày tốt lành.</p>
        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Về trang chủ</a>
    }
</div>