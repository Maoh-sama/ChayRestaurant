@{
    ViewData["Title"] = "Thanh toán thành công";
    Layout = "~/Views/Shared/layoutnew.cshtml"; // Hoặc layout hiện tại cậu đang dùng
}

<div class="container" style="margin-top: 50px; margin-bottom: 50px;">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center p-5">
                    <div style="color: #28a745; font-size: 80px; margin-bottom: 20px;">
                        <i class="fa fa-check-circle"></i>
                    </div>

                    <h2 class="text-success mb-3">Thanh toán thành công!</h2>

                    <p class="lead mb-4">
                        @ViewBag.Message <br />
                        Cảm ơn bạn đã mua hàng tại Cửa Hàng Chay.
                    </p>

                    <hr class="my-4">

                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <a href="/" class="btn btn-primary btn-lg px-4 gap-3">
                            <i class="fa fa-home"></i> Về trang chủ
                        </a>
                        <a href="/Product" class="btn btn-outline-secondary btn-lg px-4">
                            Tiếp tục mua sắm
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />