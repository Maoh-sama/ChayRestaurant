@model List<Cuahangchay.Models.HoaDon>
@{
    ViewData["Title"] = "Thống kê doanh thu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@using (Html.BeginForm("ThongKeDoanhThu", "Home", FormMethod.Get))
{
    <div class="form-row">
        <div class="form-group col-md-4">
            <label for="startDate">Ngày bắt đầu</label>
            <input type="date" class="form-control" id="startDate" name="startDate" value="@ViewBag.StartDate?.ToString("yyyy-MM-dd")">
        </div>
        <div class="form-group col-md-4">
            <label for="endDate">Ngày kết thúc</label>
            <input type="date" class="form-control" id="endDate" name="endDate" value="@ViewBag.EndDate?.ToString("yyyy-MM-dd")">
        </div>
        <div class="form-group col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">Lọc</button>
        </div>
    </div>
}
    <!-- Bảng doanh thu -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Tổng doanh thu theo hóa đơn</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Mã Hóa đơn</th>
                            <th>Ngày lập</th>
                            <th>Tổng tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model ?? new List<Cuahangchay.Models.HoaDon>())
                        {
                            <tr>
                                <td>@item.HoaDonID</td>
                                <td>@item.NgayLap.ToString("dd/MM/yyyy")</td>
                                <td>@((item.TongTien ?? 0).ToString("N0")) VNĐ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

