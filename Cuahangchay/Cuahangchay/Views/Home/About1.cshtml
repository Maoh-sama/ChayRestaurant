@{
    ViewData["Title"] = "Giới Thiệu";
    Layout = "~/Views/Shared/_Layoutold.cshtml";
}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
</head>
<body>
    <div>
        <h2 class="text-success text-center">Giới thiệu</h2>
        <p class="text-success text-center">Chúng tôi là nhà hàng Thanh Lương phục vụ món Việt kết hợp hiện đại từ năm 2000.</p>

        <img src="~/img/Nha hang chay.jpg" class="img-fluid my-4 rounded" alt="Nhà hàng Thanh Lương" />

        <h4 class="text-center mb-4" style="color: #4CAF50; font-weight: bold;">Sứ mệnh của chúng tôi</h4>
        <ul class="list-group list-group-flush">
            <li class="list-group-item bg-transparent"><i class="bi bi-check-circle-fill text-success me-2"></i>Đem đến những món ăn chay ngon và bổ dưỡng.</li>
            <li class="list-group-item bg-transparent"><i class="bi bi-check-circle-fill text-success me-2"></i>Sử dụng nguyên liệu tự nhiên, không chất bảo quản.</li>
            <li class="list-group-item bg-transparent"><i class="bi bi-check-circle-fill text-success me-2"></i>Lan tỏa lối sống xanh và lành mạnh đến cộng đồng.</li>
        </ul>


    </div>
</body>
</html>
